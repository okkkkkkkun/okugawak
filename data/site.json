    },
    {
      "title": "AAVS Osaka 2019",
      "file": "02_Works/linktoPage/aavs/index.html",
      "thumb": "https://pub-47d33dd99ef84f2d914d1825c4839e75.r2.dev/works/aavs-osaka/handibot.png",
